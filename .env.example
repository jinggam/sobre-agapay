# Sobre Proxy Server — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ----- Lumen OCR -----
# Base URL of the Lumen OCR API endpoint (e.g., https://api.lumen.example/v1/ocr)
LUMEN_OCR_API_URL=https://api.staging.nonlive.lumen.bayanichain.tech/ocr/documents

# API key for authenticating with the Lumen OCR service
LUMEN_OCR_API_KEY=4d4a16bd-7c2b-4f43-9a77-40cf400e64ab

# ----- Lumen AI Chat -----
# Base URL of the Lumen AI Chat API endpoint (e.g., https://api.lumen.example/v1/chat)
LUMEN_CHAT_API_URL=https://api.staging.nonlive.lumen.bayanichain.tech/ai_chat/instances

# API key for authenticating with the Lumen AI Chat service
LUMEN_CHAT_API_KEY=4d4a16bd-7c2b-4f43-9a77-40cf400e64ab

# ----- Proxy Server -----
# Port the Express proxy listens on (Vite dev proxy targets this)
PORT=3001
